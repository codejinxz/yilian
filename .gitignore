.mvn/wrapper/maven-wrapper.jar

# ---------------------------------------------------------------------------
# Python 工具
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.tox/

# ---------------------------------------------------------------------------
# 密钥 / 本地配置
# 不提交任何凭据；本机配置模板见 server/config/application-local.yml.example。
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
credentials.*
secrets.*

# 本机真实配置（含明文 MySQL 密码与 JWT 开发密钥）只留在 server/config/；
# 通过 spring.config.additional-location 加载，不进入 classpath / jar。
server/config/application-local.yml
!server/config/application-local.yml.example

# ---------------------------------------------------------------------------
# 浏览器用户目录与截图
# prototype/shots 包含 Edge 用户数据目录（Default/Cache、Code Cache、
# GPUCache、Local Storage 等）以及截图 PNG。它是本地生成物而非源码，
# 不得推送。
# ---------------------------------------------------------------------------
prototype/shots/
playwright-report/
test-results/
blob-report/
*.har

# ---------------------------------------------------------------------------
# 可视化 / Office 临时文件
# ---------------------------------------------------------------------------
~$*
*.tmp.*

# ZCode 会话产物（本机工作区）
.zcode/
