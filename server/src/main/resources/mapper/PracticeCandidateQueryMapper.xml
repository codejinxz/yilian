<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.codejinxz.yilian.content.dao.mybatis.PracticeCandidateQueryMapper">

    <!--
      练习候选（ContentQueryServiceImpl.findPracticeCandidates）：单条 JOIN 直出，
      语义与原 JPA 两步查询一致——
      - 题库可见性：status=PUBLISHED 且未软删；
      - 题目可见性：status=PUBLISHED 且未软删；
      - INNER JOIN 当前快照：快照缺失（current_version_id 为 NULL 或指向缺失行）的候选天然丢弃；
      - 排序与原实现一致：created_at 升序、id 升序（同秒内按 ULID 稳定）；
      - 动态条件：bankId / excludeIds / tag 任一可为空。
      - 考点用 JSON_CONTAINS 做「数组精确成员」匹配，与错题列表的内存 matchTag 同口径；
        不用 LIKE，避免「搭配」误命中「固定搭配」这类包含关系的考点名。
    -->
    <select id="findCandidates"
            resultType="io.github.codejinxz.yilian.content.dao.PracticeCandidateRow">
        SELECT s.id                AS sentence_id,
               s.bank_id           AS bank_id,
               s.version           AS version,
               s.current_version_id AS version_id,
               v.version_no        AS version_no,
               s.status            AS status,
               v.zh                AS zh,
               v.ref               AS ref,
               v.note              AS note,
               v.chunks            AS chunks,
               v.blank             AS blank,
               v.tags              AS tags,
               v.level             AS level
        FROM sentences s
        JOIN sentence_banks b ON b.id = s.bank_id
        JOIN sentence_versions v ON v.id = s.current_version_id
        WHERE b.status = 'PUBLISHED'
          AND b.deleted_at IS NULL
          AND s.status = 'PUBLISHED'
          AND s.deleted_at IS NULL
        <if test="bankId != null">
            AND s.bank_id = #{bankId}
        </if>
        <if test="excludeIds != null and !excludeIds.isEmpty()">
            AND s.id NOT IN
            <foreach collection="excludeIds" item="excludedId" open="(" separator="," close=")">
                #{excludedId}
            </foreach>
        </if>
        <if test="tag != null and tag != ''">
            AND JSON_CONTAINS(v.tags, JSON_QUOTE(#{tag}))
        </if>
        ORDER BY s.created_at ASC, s.id ASC
        LIMIT #{limit}
    </select>
</mapper>
